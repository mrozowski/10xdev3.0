{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "type": "command",
        "bash": "npm run lint",
        "powershell": "npm run lint",
        "cwd": ".",
        "timeoutSec": 120
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "npm run typecheck",
        "powershell": "npm run typecheck",
        "cwd": ".",
        "timeoutSec": 120
      }
    ]
  }
}
