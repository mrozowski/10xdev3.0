---
import { getPreferences } from '../../lib/preferences';

const preferences = getPreferences();
---

<div id="memory-game-root" class="memory-game-wrapper" data-theme={preferences.theme}>
	<!-- Top Controls & HUD -->
	<header class="game-hud">
		<div class="hud-item score-box">
			<span class="hud-label">SCORE</span>
			<span id="hud-score" class="hud-value neon-cyan">0</span>
		</div>

		<div class="hud-item round-box">
			<span class="hud-label">ROUND</span>
			<span id="hud-round" class="hud-value neon-green">1/1</span>
		</div>

		<div class="hud-item combo-box">
			<span class="hud-label">COMBO</span>
			<span id="hud-combo" class="hud-value neon-pink">x1</span>
		</div>

		<div class="hud-item timer-box">
			<span class="hud-label">TIME</span>
			<span id="hud-timer" class="hud-value neon-yellow">60s</span>
		</div>

		<div class="hud-item sound-control">
			<button id="btn-sound-toggle" class="retro-btn icon-btn" type="button" aria-label="Toggle Sound">
				<span id="sound-icon" class="sound-status">🔊</span>
			</button>
		</div>
	</header>

	<!-- Preview Countdown Alert / Bar -->
	<div id="preview-banner" class="preview-banner">
		<div class="preview-text">
			MEMORIZE CARDS: <span id="preview-countdown" class="neon-green">3</span>s
		</div>
		<div class="preview-progress-track">
			<div id="preview-progress-bar" class="preview-progress-fill"></div>
		</div>
	</div>

	<!-- 4x4 Cards Grid Container -->
	<main class="grid-container" id="cards-grid">
		<!-- 16 Cards are rendered and bound by the client script -->
	</main>

	<section class="local-data-panel" aria-labelledby="memory-local-data-heading">
		<div class="local-data-copy">
			<h2 id="memory-local-data-heading" class="local-data-heading">LOCAL GAME DATA</h2>
			<p>
				Scores and stats are stored only in this browser profile. Everyone using this profile
				can view, rename, or clear them.
			</p>
		</div>

		<div class="local-data-grid">
			<section class="score-management-panel" aria-labelledby="memory-scores-heading">
				<div class="panel-header">
					<h3 id="memory-scores-heading" class="panel-heading">SCORES</h3>
					<button id="btn-clear-scores" class="retro-btn danger-btn" type="button">
						CLEAR SCORES
					</button>
				</div>
				<ul id="memory-score-list" class="managed-score-list" aria-live="polite"></ul>
			</section>

			<section class="stats-panel" aria-labelledby="memory-stats-heading">
				<div class="panel-header">
					<h3 id="memory-stats-heading" class="panel-heading">LOCAL STATS</h3>
					<button id="btn-clear-stats" class="retro-btn danger-btn" type="button">
						CLEAR STATS
					</button>
				</div>
				<dl class="stats-list">
					<div class="stat-row">
						<dt>Platform time</dt>
						<dd id="stat-platform-time">0s</dd>
					</div>
					<div class="stat-row">
						<dt>Memory Cards time</dt>
						<dd id="stat-game-time">0s</dd>
					</div>
					<div class="stat-row">
						<dt>Games played</dt>
						<dd id="stat-games-played">0</dd>
					</div>
					<div class="stat-row">
						<dt>Total points</dt>
						<dd id="stat-total-points">0</dd>
					</div>
					<div class="stat-row">
						<dt>Average points</dt>
						<dd id="stat-average-points">0</dd>
					</div>
					<div class="stat-row">
						<dt>Average game time</dt>
						<dd id="stat-average-time">0s</dd>
					</div>
					<div class="stat-row">
						<dt>Last played</dt>
						<dd id="stat-last-played">Never</dd>
					</div>
				</dl>
			</section>
		</div>
	</section>

	<!-- Game Over / Victory Modal Overlay -->
	<div id="game-modal" class="modal-overlay hidden" role="dialog" aria-modal="true">
		<div class="modal-card">
			<div class="modal-header">
				<h2 id="modal-title" class="modal-title neon-green">VICTORY!</h2>
			</div>
			<div class="modal-body">
				<p id="modal-message" class="modal-subtitle">All pairs matched in time!</p>

				<div class="modal-stats">
					<div class="stat-row">
						<span>Final Score:</span>
						<strong id="modal-final-score" class="neon-cyan">0</strong>
					</div>
					<div class="stat-row" id="stat-time-bonus-row">
						<span>Time Bonus:</span>
						<strong id="modal-time-bonus" class="neon-yellow">+0</strong>
					</div>
				</div>

				<div class="name-entry-row hidden" id="name-entry-row">
					<label for="score-name-input" class="name-entry-label">Save score as:</label>
					<input
						id="score-name-input"
						class="name-entry-input"
						type="text"
						maxlength="24"
						placeholder="Anonymous"
						autocomplete="off"
					/>
				</div>

				<div class="modal-actions">
					<button id="btn-play-again" class="retro-btn primary-btn" type="button">
						PLAY AGAIN
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import {
		tickPreview,
		tickTimer,
		flipCard,
		resolveMismatch,
		startRound,
		PREVIEW_SECONDS,
		TIME_BONUS_PER_SECOND,
		TOTAL_ROUNDS,
		type GameState,
	} from '../../lib/memory-game/engine';
	import { getThemeSymbols, type ThemeSymbol } from '../../lib/memory-game/themes';
	import { playSound, initAudioContext } from '../../lib/sound';
	import { getPreferences, setSoundEnabled } from '../../lib/preferences';
	import {
		addScore,
		clearScoresForGame,
		deleteScore,
		getScoresForGame,
		renameScore,
		type ScoreEntry,
	} from '../../lib/scores';
	import {
		clearStats,
		getGameStatsSummary,
		getStats,
		recordCompletedGame,
		recordGameOpened,
		recordGameTime,
	} from '../../lib/stats';

	const MEMORY_GAME_ID = 'memory-cards';
	const MISMATCH_COOLDOWN_MS = 800;
	const RESIZE_DEBOUNCE_MS = 150;

	class MemoryGameIsland {
		private root: HTMLElement;
		private gridEl: HTMLElement;
		private hudScore: HTMLElement;
		private hudRound: HTMLElement;
		private hudCombo: HTMLElement;
		private hudTimer: HTMLElement;
		private previewBanner: HTMLElement;
		private previewCountdown: HTMLElement;
		private previewProgressBar: HTMLElement;
		private soundToggleBtn: HTMLButtonElement;
		private soundIcon: HTMLElement;
		private modal: HTMLElement;
		private modalTitle: HTMLElement;
		private modalMessage: HTMLElement;
		private modalFinalScore: HTMLElement;
		private modalTimeBonus: HTMLElement;
		private timeBonusRow: HTMLElement;
		private btnPlayAgain: HTMLButtonElement;
		private nameEntryRow: HTMLElement;
		private scoreNameInput: HTMLInputElement;
		private scoreList: HTMLElement;
		private clearScoresButton: HTMLButtonElement;
		private clearStatsButton: HTMLButtonElement;
		private statPlatformTime: HTMLElement;
		private statGameTime: HTMLElement;
		private statGamesPlayed: HTMLElement;
		private statTotalPoints: HTMLElement;
		private statAveragePoints: HTMLElement;
		private statAverageTime: HTMLElement;
		private statLastPlayed: HTMLElement;

		private state!: GameState;
		private previewInterval: number | null = null;
		private roundInterval: number | null = null;
		private mismatchTimeout: number | null = null;
		private resizeTimeout: number | null = null;
		private gameViewIsActive = false;
		private gameViewOpenedAt: number | null = null;
		private sessionStatsRecorded = false;
		private symbolsMap: Map<string, ThemeSymbol> = new Map();
		private symbolIds: string[] = [];
		/** Determines what the modal's single action button does when clicked. */
		private nextAction: 'advance' | 'restart' = 'restart';
		/** Score awaiting the player's optional name before it's persisted via addScore(). */
		private pendingScore: { score: number; roundsCompleted: number } | null = null;

		constructor(root: HTMLElement) {
			this.root = root;
			this.gridEl = root.querySelector('#cards-grid') as HTMLElement;
			this.hudScore = root.querySelector('#hud-score') as HTMLElement;
			this.hudRound = root.querySelector('#hud-round') as HTMLElement;
			this.hudCombo = root.querySelector('#hud-combo') as HTMLElement;
			this.hudTimer = root.querySelector('#hud-timer') as HTMLElement;
			this.previewBanner = root.querySelector('#preview-banner') as HTMLElement;
			this.previewCountdown = root.querySelector('#preview-countdown') as HTMLElement;
			this.previewProgressBar = root.querySelector('#preview-progress-bar') as HTMLElement;
			this.soundToggleBtn = root.querySelector('#btn-sound-toggle') as HTMLButtonElement;
			this.soundIcon = root.querySelector('#sound-icon') as HTMLElement;
			this.modal = root.querySelector('#game-modal') as HTMLElement;
			this.modalTitle = root.querySelector('#modal-title') as HTMLElement;
			this.modalMessage = root.querySelector('#modal-message') as HTMLElement;
			this.modalFinalScore = root.querySelector('#modal-final-score') as HTMLElement;
			this.modalTimeBonus = root.querySelector('#modal-time-bonus') as HTMLElement;
			this.timeBonusRow = root.querySelector('#stat-time-bonus-row') as HTMLElement;
			this.btnPlayAgain = root.querySelector('#btn-play-again') as HTMLButtonElement;
			this.nameEntryRow = root.querySelector('#name-entry-row') as HTMLElement;
			this.scoreNameInput = root.querySelector('#score-name-input') as HTMLInputElement;
			this.scoreList = root.querySelector('#memory-score-list') as HTMLElement;
			this.clearScoresButton = root.querySelector('#btn-clear-scores') as HTMLButtonElement;
			this.clearStatsButton = root.querySelector('#btn-clear-stats') as HTMLButtonElement;
			this.statPlatformTime = root.querySelector('#stat-platform-time') as HTMLElement;
			this.statGameTime = root.querySelector('#stat-game-time') as HTMLElement;
			this.statGamesPlayed = root.querySelector('#stat-games-played') as HTMLElement;
			this.statTotalPoints = root.querySelector('#stat-total-points') as HTMLElement;
			this.statAveragePoints = root.querySelector('#stat-average-points') as HTMLElement;
			this.statAverageTime = root.querySelector('#stat-average-time') as HTMLElement;
			this.statLastPlayed = root.querySelector('#stat-last-played') as HTMLElement;

			this.bindEvents();
			this.startNewGame();
			this.renderScores();
			this.renderStats();
		}

		private bindEvents(): void {
			this.soundToggleBtn.addEventListener('click', () => {
				initAudioContext();
				const enabled = !getPreferences().soundEnabled;
				setSoundEnabled(enabled);
				this.updateSoundIcon(enabled);
				if (enabled) {
					playSound('tick');
				}
			});

			this.btnPlayAgain.addEventListener('click', () => {
				initAudioContext();
				playSound('tick');

				if (this.nextAction === 'restart' && this.pendingScore) {
					const name = this.scoreNameInput.value.trim();
					const existingIds = new Set(getScoresForGame(MEMORY_GAME_ID).map(({ id }) => id));
					const savedScores = addScore({
						gameId: MEMORY_GAME_ID,
						name,
						score: this.pendingScore.score,
						roundsCompleted: this.pendingScore.roundsCompleted,
					});
					this.pendingScore = null;
					const newEntryId = savedScores.find(({ id }) => !existingIds.has(id))?.id;
					this.renderScores(newEntryId);
				}

				this.modal.classList.add('hidden');
				if (this.nextAction === 'advance') {
					this.advanceToNextRound();
				} else {
					this.startNewGame();
				}
			});

			// Unlock the browser AudioContext on the first user gesture.
			this.root.addEventListener('pointerdown', () => initAudioContext(), { once: true });

			this.clearScoresButton.addEventListener('click', () => {
				if (!window.confirm('Clear all Memory Cards scores stored in this browser profile?')) {
					return;
				}

				clearScoresForGame(MEMORY_GAME_ID);
				this.renderScores();
			});

			this.clearStatsButton.addEventListener('click', () => {
				if (!window.confirm('Clear local stats stored in this browser profile?')) {
					return;
				}

				clearStats();
				if (this.gameViewOpenedAt !== null) {
					this.gameViewOpenedAt = Date.now();
				}
				window.dispatchEvent(new CustomEvent('memory-game:stats-cleared'));
				this.renderStats();
			});

			window.addEventListener('memory-game:view-opened', () => this.handleGameViewOpened());
			window.addEventListener('memory-game:view-closed', () => this.handleGameViewClosed());
			window.addEventListener('pagehide', () => this.flushGameViewTime());
			window.addEventListener('beforeunload', () => this.flushGameViewTime());
			window.addEventListener('resize', () => this.scheduleColumnRecompute());
			window.addEventListener('orientationchange', () => this.scheduleColumnRecompute());
		}

		private updateSoundIcon(enabled: boolean): void {
			this.soundIcon.textContent = enabled ? '🔊' : '🔇';
			this.soundToggleBtn.classList.toggle('muted', !enabled);
		}

		private handleGameViewOpened(): void {
			if (this.gameViewIsActive) {
				return;
			}

			this.gameViewIsActive = true;
			this.gameViewOpenedAt = Date.now();
			recordGameOpened(MEMORY_GAME_ID);
			this.startNewGame();
			this.renderStats();
		}

		private handleGameViewClosed(): void {
			this.flushGameViewTime();
			this.gameViewOpenedAt = null;
			this.gameViewIsActive = false;
			this.clearTimers();
		}

		private flushGameViewTime(): void {
			if (this.gameViewOpenedAt === null) {
				return;
			}

			const now = Date.now();
			recordGameTime(MEMORY_GAME_ID, now - this.gameViewOpenedAt);
			this.gameViewOpenedAt = now;
			this.renderStats();
		}

		private recordSessionCompletion(): void {
			if (this.sessionStatsRecorded) {
				return;
			}

			this.flushGameViewTime();
			recordCompletedGame(MEMORY_GAME_ID, this.state.score);
			this.sessionStatsRecorded = true;
			this.renderStats();
		}

		public startNewGame(): void {
			const currentPrefs = getPreferences();
			const symbols = getThemeSymbols(currentPrefs.theme);
			this.symbolsMap = new Map(symbols.map((symbol) => [symbol.id, symbol]));
			this.symbolIds = symbols.map((symbol) => symbol.id);
			this.updateSoundIcon(currentPrefs.soundEnabled);
			this.sessionStatsRecorded = false;

			this.beginRound(startRound(1, this.symbolIds, 0));
		}

		private advanceToNextRound(): void {
			this.beginRound(startRound(this.state.round + 1, this.symbolIds, this.state.score));
		}

		private beginRound(state: GameState): void {
			this.clearTimers();
			this.state = state;

			this.renderGrid();
			this.updateHUD();
			this.recomputeColumns();
			this.hudTimer.classList.remove('pulse-danger');

			if (!this.gameViewIsActive) {
				return;
			}

			if (this.state.status !== 'preview') {
				// Round 2+ starts directly in 'playing' with cards face down (skipPreview).
				this.previewBanner.classList.add('hidden');
				this.startRoundTimer();
				return;
			}

			this.previewBanner.classList.remove('hidden');
			this.previewCountdown.textContent = String(PREVIEW_SECONDS);
			this.previewProgressBar.style.width = '100%';

			this.previewInterval = window.setInterval(() => {
				this.state = tickPreview(this.state);

				if (this.state.status === 'preview') {
					playSound('tick');
					this.previewCountdown.textContent = String(this.state.previewSecondsRemaining);
					this.previewProgressBar.style.width = `${
						(this.state.previewSecondsRemaining / PREVIEW_SECONDS) * 100
					}%`;
					return;
				}

				// Preview finished: hide every card and start the round.
				this.clearTimers();
				this.previewProgressBar.style.width = '0%';
				this.previewBanner.classList.add('hidden');
				this.syncCards();
				playSound('flip');
				this.startRoundTimer();
			}, 1000);
		}

		private startRoundTimer(): void {
			this.roundInterval = window.setInterval(() => {
				this.state = tickTimer(this.state);
				this.hudTimer.textContent = `${this.state.roundSecondsRemaining}s`;

				if (this.state.status === 'time_up') {
					this.clearTimers();
					this.syncCards();
					playSound('gameover');
					this.pendingScore = { score: this.state.score, roundsCompleted: this.state.round - 1 };
					this.recordSessionCompletion();
					this.nextAction = 'restart';
					this.showGameOverModal();
					return;
				}

				if (this.state.roundSecondsRemaining <= 10) {
					this.hudTimer.classList.add('pulse-danger');
					playSound('tick');
				}
			}, 1000);
		}

		private computeColumns(totalPairs: number): number {
			if (window.matchMedia('(max-width: 480px)').matches) {
				return 4;
			}
			if (totalPairs <= 8) {
				return 4;
			}
			if (totalPairs <= 10) {
				return 5;
			}
			if (totalPairs <= 12) {
				return 6;
			}
			if (totalPairs <= 14) {
				return 7;
			}
			return 8;
		}

		private recomputeColumns(): void {
			const cols = this.computeColumns(this.state.totalPairs);
			this.gridEl.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;
		}

		private scheduleColumnRecompute(): void {
			if (this.resizeTimeout !== null) {
				clearTimeout(this.resizeTimeout);
			}
			this.resizeTimeout = window.setTimeout(() => {
				this.resizeTimeout = null;
				this.recomputeColumns();
			}, RESIZE_DEBOUNCE_MS);
		}

		private clearTimers(): void {
			if (this.previewInterval !== null) {
				clearInterval(this.previewInterval);
				this.previewInterval = null;
			}
			if (this.roundInterval !== null) {
				clearInterval(this.roundInterval);
				this.roundInterval = null;
			}
			if (this.mismatchTimeout !== null) {
				clearTimeout(this.mismatchTimeout);
				this.mismatchTimeout = null;
			}
			if (this.resizeTimeout !== null) {
				clearTimeout(this.resizeTimeout);
				this.resizeTimeout = null;
			}
		}

		private renderGrid(): void {
			this.gridEl.innerHTML = '';

			this.state.cards.forEach((card, index) => {
				const symbol = this.symbolsMap.get(card.symbolId);
				const cardButton = document.createElement('button');
				cardButton.className = 'card-item';
				cardButton.type = 'button';
				cardButton.dataset.index = String(index);
				cardButton.setAttribute('aria-label', `Card ${index + 1}`);
				cardButton.innerHTML = `
					<span class="card-inner${card.isFlipped ? ' is-flipped' : ''}">
						<span class="card-face card-back"></span>
						<span class="card-face card-front" style="--symbol-color: ${symbol?.color ?? '#00f0ff'}">
							<svg class="symbol-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">${
								symbol?.svgPath ?? ''
							}</svg>
						</span>
					</span>
				`;

				cardButton.addEventListener('click', () => this.handleCardClick(index));
				this.gridEl.appendChild(cardButton);
			});
		}

		private handleCardClick(index: number): void {
			if (!this.gameViewIsActive || this.state.status !== 'playing') {
				return;
			}

			const { nextState, event } = flipCard(this.state, index);
			if (!event) {
				return;
			}

			this.state = nextState;
			this.syncCards();
			this.updateHUD();

			switch (event) {
				case 'flip':
					playSound('flip');
					break;

				case 'match':
					playSound('match');
					break;

				case 'completed':
					this.clearTimers();
					playSound('victory');
					this.pendingScore = { score: this.state.score, roundsCompleted: this.state.roundsTotal };
					this.recordSessionCompletion();
					this.nextAction = 'restart';
					this.showVictoryModal();
					break;

				case 'round_complete':
					this.clearTimers();
					playSound('victory');
					this.nextAction = 'advance';
					this.showRoundCompleteModal();
					break;

				case 'mismatch':
					playSound('mismatch');
					this.mismatchTimeout = window.setTimeout(() => {
						this.mismatchTimeout = null;
						this.state = resolveMismatch(this.state);
						this.syncCards();
					}, MISMATCH_COOLDOWN_MS);
					break;
			}
		}

		/** Reconciles every card element with the engine's card state. */
		private syncCards(): void {
			const cardEls = this.gridEl.querySelectorAll<HTMLButtonElement>('.card-item');

			this.state.cards.forEach((card, index) => {
				const el = cardEls[index];
				if (!el) {
					return;
				}

				const inner = el.querySelector('.card-inner');
				inner?.classList.toggle('is-flipped', card.isFlipped || card.isMatched);
				inner?.classList.toggle('is-matched', card.isMatched);
				el.disabled = card.isMatched;
			});
		}

		private updateHUD(): void {
			this.hudScore.textContent = String(this.state.score);
			this.hudRound.textContent = `${this.state.round}/${this.state.roundsTotal}`;
			this.hudCombo.textContent = `x${Math.max(1, this.state.combo)}`;
			this.hudTimer.textContent = `${this.state.roundSecondsRemaining}s`;
		}

		private renderScores(highlightId?: string): void {
			this.scoreList.replaceChildren();
			const scores = getScoresForGame(MEMORY_GAME_ID);

			if (scores.length === 0) {
				const emptyState = document.createElement('li');
				emptyState.className = 'managed-score-empty';
				emptyState.textContent = 'No Memory Cards scores yet.';
				this.scoreList.appendChild(emptyState);
				return;
			}

			scores.forEach((score, index) => {
				this.scoreList.appendChild(this.createScoreRow(score, index, highlightId));
			});
		}

		private createScoreRow(score: ScoreEntry, index: number, highlightId?: string): HTMLLIElement {
			const row = document.createElement('li');
			row.className = 'managed-score-row';
			row.dataset.scoreId = score.id;
			if (highlightId === score.id) {
				row.classList.add('newly-saved');
			}

			const details = document.createElement('div');
			details.className = 'managed-score-details';

			const primary = document.createElement('div');
			primary.className = 'managed-score-primary';

			const rank = document.createElement('span');
			rank.className = 'managed-score-rank';
			rank.textContent = `#${index + 1}`;

			const name = document.createElement('span');
			name.className = 'managed-score-name';
			name.textContent = score.name;

			const points = document.createElement('span');
			points.className = 'managed-score-points';
			points.textContent = `${score.score} pts`;

			primary.append(rank, name, points);

			const meta = document.createElement('div');
			meta.className = 'managed-score-meta';
			meta.textContent = `Completed: ${score.roundsCompleted ?? 0} • ${this.formatDate(score.date)}`;

			details.append(primary, meta);

			const actions = document.createElement('div');
			actions.className = 'managed-score-actions';

			const renameButton = document.createElement('button');
			renameButton.className = 'retro-btn compact-btn';
			renameButton.type = 'button';
			renameButton.textContent = 'RENAME';
			renameButton.setAttribute('aria-label', `Rename score for ${score.name}`);
			renameButton.addEventListener('click', () => this.renderRenameScoreRow(score));

			const deleteButton = document.createElement('button');
			deleteButton.className = 'retro-btn compact-btn danger-btn';
			deleteButton.type = 'button';
			deleteButton.textContent = 'DELETE';
			deleteButton.setAttribute('aria-label', `Delete score for ${score.name}`);
			deleteButton.addEventListener('click', () => {
				if (!window.confirm(`Delete ${score.name}'s Memory Cards score?`)) {
					return;
				}

				deleteScore(MEMORY_GAME_ID, score.id);
				this.renderScores();
			});

			actions.append(renameButton, deleteButton);
			row.append(details, actions);
			return row;
		}

		private renderRenameScoreRow(score: ScoreEntry): void {
			const rows = Array.from(this.scoreList.querySelectorAll<HTMLLIElement>('.managed-score-row'));
			const row = rows.find((candidate) => candidate.dataset.scoreId === score.id);

			if (!row) {
				return;
			}

			row.replaceChildren();
			row.classList.add('editing');

			const label = document.createElement('label');
			label.className = 'managed-score-edit-label';
			label.textContent = 'Score label';

			const input = document.createElement('input');
			input.className = 'managed-score-input';
			input.type = 'text';
			input.maxLength = 24;
			input.value = score.name;
			input.setAttribute('aria-label', `New name for ${score.name}`);

			const actions = document.createElement('div');
			actions.className = 'managed-score-actions';

			const saveButton = document.createElement('button');
			saveButton.className = 'retro-btn compact-btn';
			saveButton.type = 'button';
			saveButton.textContent = 'SAVE';
			saveButton.addEventListener('click', () => {
				renameScore(MEMORY_GAME_ID, score.id, input.value);
				this.renderScores(score.id);
			});

			const cancelButton = document.createElement('button');
			cancelButton.className = 'retro-btn compact-btn secondary-action-btn';
			cancelButton.type = 'button';
			cancelButton.textContent = 'CANCEL';
			cancelButton.addEventListener('click', () => this.renderScores());

			actions.append(saveButton, cancelButton);
			row.append(label, input, actions);
			input.focus();
			input.select();
		}

		private renderStats(): void {
			const stats = getStats();
			const gameStats = getGameStatsSummary(MEMORY_GAME_ID);

			this.statPlatformTime.textContent = this.formatDuration(stats.totalPlatformTimeMs);
			this.statGameTime.textContent = this.formatDuration(gameStats.totalPlayTimeMs);
			this.statGamesPlayed.textContent = String(gameStats.gamesPlayed);
			this.statTotalPoints.textContent = String(gameStats.totalPoints);
			this.statAveragePoints.textContent = String(Math.round(gameStats.averagePoints));
			this.statAverageTime.textContent = this.formatDuration(gameStats.averagePlayTimeMs);
			this.statLastPlayed.textContent =
				gameStats.lastPlayedAt === null ? 'Never' : this.formatDate(gameStats.lastPlayedAt);
		}

		private formatDuration(durationMs: number): string {
			const seconds = Math.floor(durationMs / 1000);
			if (seconds < 60) {
				return `${seconds}s`;
			}

			const minutes = Math.floor(seconds / 60);
			const remainingSeconds = seconds % 60;
			return `${minutes}m ${remainingSeconds}s`;
		}

		private formatDate(date: string): string {
			const parsed = new Date(date);
			if (Number.isNaN(parsed.getTime())) {
				return 'Unknown date';
			}

			return parsed.toLocaleDateString(undefined, {
				month: 'short',
				day: 'numeric',
				hour: '2-digit',
				minute: '2-digit',
			});
		}

		private showVictoryModal(): void {
			this.modalTitle.textContent = 'VICTORY!';
			this.modalTitle.className = 'modal-title neon-green';
			this.modalMessage.textContent = `All ${TOTAL_ROUNDS} rounds complete!`;
			this.modalFinalScore.textContent = String(this.state.score);
			this.modalTimeBonus.textContent = `+${
				this.state.roundSecondsRemaining * TIME_BONUS_PER_SECOND
			} pts`;
			this.timeBonusRow.classList.remove('hidden');
			this.btnPlayAgain.textContent = 'PLAY AGAIN';
			this.setNameEntryVisible(true);
			this.modal.classList.remove('hidden');
		}

		private showRoundCompleteModal(): void {
			this.modalTitle.textContent = `ROUND ${this.state.round} COMPLETE!`;
			this.modalTitle.className = 'modal-title neon-green';
			this.modalMessage.textContent = `All ${this.state.totalPairs} pairs matched! Get ready for round ${
				this.state.round + 1
			}.`;
			this.modalFinalScore.textContent = String(this.state.score);
			this.modalTimeBonus.textContent = `+${
				this.state.roundSecondsRemaining * TIME_BONUS_PER_SECOND
			} pts`;
			this.timeBonusRow.classList.remove('hidden');
			this.btnPlayAgain.textContent = 'NEXT ROUND';
			this.setNameEntryVisible(false);
			this.modal.classList.remove('hidden');
		}

		private showGameOverModal(): void {
			this.modalTitle.textContent = 'TIME UP!';
			this.modalTitle.className = 'modal-title neon-pink';
			this.modalMessage.textContent = 'The timer ran out before all pairs were found.';
			this.modalFinalScore.textContent = String(this.state.score);
			this.timeBonusRow.classList.add('hidden');
			this.btnPlayAgain.textContent = 'PLAY AGAIN';
			this.setNameEntryVisible(true);
			this.modal.classList.remove('hidden');
		}

		private setNameEntryVisible(visible: boolean): void {
			this.scoreNameInput.value = '';
			this.nameEntryRow.classList.toggle('hidden', !visible);
		}
	}

	const root = document.getElementById('memory-game-root');
	if (root) {
		new MemoryGameIsland(root);
	}
</script>

