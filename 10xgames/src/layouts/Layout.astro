---
interface Props {
	title?: string;
}

const { title = '10x Games — Retro Browser Games' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="crt-theme">
		<div class="crt-scanlines"></div>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #0b0e14;
		--panel-bg: #111620;
		--border-color: #232d3d;
		--text-main: #e2e8f0;
		--text-muted: #8492a6;
		--neon-cyan: #00f0ff;
		--neon-pink: #ff007f;
		--neon-green: #00ff9f;
		--neon-yellow: #ffe600;
	}

	* {
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100vh;
		background-color: var(--bg-color);
		color: var(--text-main);
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		overflow-x: hidden;
	}

	/* CRT Retro Aesthetic Scanlines */
	.crt-scanlines {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background: linear-gradient(
			rgba(18, 16, 16, 0) 50%,
			rgba(0, 0, 0, 0.25) 50%
		);
		background-size: 100% 4px;
		z-index: 999;
		pointer-events: none;
		opacity: 0.6;
	}

	/* Scrollbars */
	::-webkit-scrollbar {
		width: 8px;
	}
	::-webkit-scrollbar-track {
		background: #0b0e14;
	}
	::-webkit-scrollbar-thumb {
		background: #232d3d;
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #00f0ff;
	}
</style>
