---
import Layout from '../layouts/Layout.astro';
import MemoryGame from '../components/game/MemoryGame.astro';
---

<Layout title="10x Games — Retro Game Collection">
	<div class="site-container">
		<!-- Header / Logo -->
		<header class="retro-header">
			<div class="logo-badge">
				<span class="pixel-brand">10X</span>
				<span class="arcade-title">GAMES</span>
			</div>
			<p class="tagline">Instant, private, retro browser games.</p>
		</header>

		<main class="view-shell">
			<section id="catalogue-view" class="catalogue-view">
				<div class="catalogue-header">
					<h1 class="catalogue-heading">CHOOSE YOUR GAME</h1>
				</div>
				<div class="catalogue-grid">
					<button class="game-card" type="button" data-game-launch="memory-cards" aria-label="Launch Memory Cards">
						<span class="game-card-icon">🧠</span>
						<span class="game-card-title">MEMORY CARDS</span>
						<span class="game-card-subtitle">Match every pair before the timer runs out.</span>
					</button>
				</div>
			</section>

			<section id="game-view" class="game-view-container hidden" aria-live="polite">
				<div class="game-top-bar">
					<button id="btn-back-to-catalogue" class="retro-btn secondary-btn" type="button">
						← CATALOGUE
					</button>
					<h1 class="active-game-heading">MEMORY CARDS</h1>
				</div>
				<MemoryGame />
			</section>
		</main>

		<footer class="retro-footer">
			<div class="footer-info">
				<p>10x Games • Browser-profile local data • Zero ads • Zero tracking</p>
			</div>
		</footer>
	</div>
</Layout>

<script>
	import { recordPlatformTime } from '../lib/stats';

	const catalogueView = document.getElementById('catalogue-view');
	const gameView = document.getElementById('game-view');
	const launchButton = document.querySelector('[data-game-launch="memory-cards"]');
	const backButton = document.getElementById('btn-back-to-catalogue');
	let lastPlatformFlush = Date.now();

	function flushPlatformTime(): void {
		const now = Date.now();
		recordPlatformTime(now - lastPlatformFlush);
		lastPlatformFlush = now;
	}

	function setView(view: 'catalogue' | 'game'): void {
		if (!catalogueView || !gameView) {
			return;
		}

		const isCatalogue = view === 'catalogue';
		catalogueView.classList.toggle('hidden', !isCatalogue);
		gameView.classList.toggle('hidden', isCatalogue);

		flushPlatformTime();
		window.dispatchEvent(new CustomEvent(isCatalogue ? 'memory-game:view-closed' : 'memory-game:view-opened'));
	}

	window.addEventListener('pagehide', flushPlatformTime);
	window.addEventListener('beforeunload', flushPlatformTime);
	window.addEventListener('memory-game:stats-cleared', () => {
		lastPlatformFlush = Date.now();
	});

	launchButton?.addEventListener('click', () => setView('game'));
	backButton?.addEventListener('click', () => setView('catalogue'));
</script>

<style>
	.site-container {
		max-width: 680px;
		margin: 0 auto;
		padding: 1.5rem 1rem 3rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 1.8rem;
		min-height: 100vh;
	}

	/* Header */
	.retro-header {
		text-align: center;
		padding-top: 1rem;
	}

	.logo-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: #111620;
		border: 2px solid #232d3d;
		border-radius: 8px;
		padding: 0.5rem 1.2rem;
		box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
	}

	.pixel-brand {
		font-family: ui-monospace, 'Courier New', monospace;
		font-size: 1.4rem;
		font-weight: 900;
		color: #ff007f;
		text-shadow: 0 0 8px rgba(255, 0, 127, 0.5);
	}

	.arcade-title {
		font-family: ui-monospace, 'Courier New', monospace;
		font-size: 1.4rem;
		font-weight: 900;
		color: #00f0ff;
		letter-spacing: 0.1em;
		text-shadow: 0 0 8px rgba(0, 240, 255, 0.5);
	}

	.tagline {
		color: #7d8b9f;
		font-size: 0.85rem;
		margin-top: 0.6rem;
		margin-bottom: 0;
		font-family: ui-monospace, monospace;
	}

	/* Game View */
	.view-shell {
		width: 100%;
	}

	.catalogue-view,
	.game-view-container {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	.hidden {
		display: none !important;
	}

	.catalogue-header {
		width: 100%;
		max-width: 640px;
		text-align: center;
	}

	.catalogue-heading {
		font-family: ui-monospace, monospace;
		font-size: 1.15rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		color: #ffe600;
		margin: 0;
		text-shadow: 0 0 12px rgba(255, 230, 0, 0.4);
	}

	.catalogue-grid {
		width: 100%;
		max-width: 640px;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1rem;
	}

	.game-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		width: 100%;
		padding: 1.2rem 1rem;
		border: 2px solid #232d3d;
		background: linear-gradient(180deg, rgba(17, 22, 32, 0.98), rgba(12, 16, 24, 0.96));
		border-radius: 12px;
		color: #e5ebf5;
		text-align: left;
		cursor: pointer;
		transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
		box-shadow: 0 10px 18px rgba(0, 0, 0, 0.25);
	}

	.game-card:hover,
	.game-card:focus-visible {
		transform: translateY(-2px);
		border-color: #00f0ff;
		box-shadow: 0 0 18px rgba(0, 240, 255, 0.2);
		outline: none;
	}

	.game-card-icon {
		font-size: 2.2rem;
		line-height: 1;
	}

	.game-card-title {
		font-family: ui-monospace, monospace;
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		color: #00ff9f;
	}

	.game-card-subtitle {
		font-size: 0.78rem;
		line-height: 1.5;
		color: #c2c9d6;
	}

	.game-top-bar {
		width: 100%;
		max-width: 640px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.active-game-heading {
		font-family: ui-monospace, monospace;
		font-size: 1.25rem;
		font-weight: 800;
		color: #00ff9f;
		letter-spacing: 0.08em;
		margin: 0;
		text-shadow: 0 0 10px rgba(0, 255, 159, 0.4);
	}

	.retro-btn {
		border: 2px solid #232d3d;
		background: #111620;
		color: #e5ebf5;
		padding: 0.6rem 0.9rem;
		border-radius: 10px;
		font-family: ui-monospace, monospace;
		font-weight: 700;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition: border-color 0.15s ease, transform 0.15s ease;
	}

	.retro-btn:hover,
	.retro-btn:focus-visible {
		border-color: #00f0ff;
		transform: translateY(-1px);
		outline: none;
	}

	.secondary-btn {
		background: rgba(17, 22, 32, 0.9);
	}

	@media (max-width: 560px) {
		.game-top-bar {
			flex-direction: column;
			align-items: flex-start;
		}

		.active-game-heading {
			font-size: 1rem;
		}

		.catalogue-heading {
			font-size: 0.9rem;
		}
	}

	.retro-footer {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 1rem;
	}


	.footer-info {
		text-align: center;
		font-size: 0.75rem;
		color: #4b5563;
		font-family: ui-monospace, monospace;
	}
</style>
